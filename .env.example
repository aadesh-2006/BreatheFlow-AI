# BreatheFlow AI — Environment Configuration Template
# Copy this file to .env and populate with valid credentials.
# NEVER commit or share actual secrets.

# Gnani AI (Vachana Platform) API Configuration
# Get your API key from the Gnani Developer Portal
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# Speech-to-Text (STT) Settings
GNANI_STT_MODEL=prisma-v2.5
GNANI_STT_LANGUAGE_CODE=en-IN

# Text-to-Speech (TTS) Settings
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE_CODE=en-IN
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_SPEED=0.95

# Local Ollama / Qwen3-4B Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Application Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
